# Per-library virtualenvs
.venv-*/
.freeze-*.txt

# Benchmark database (regenerated by run_all.sh)
db.sqlite3

# Benchmark results. The eight artifacts docs/why.md cites BY PATH are tracked --
# a number a reader cannot open is a number nobody can check -- and they are
# 1.7 kB each. Everything else in there (summaries, ad-hoc reruns) is scratch.
# Note the shape: a re-included file needs its PARENT left un-excluded, so this
# has to be "results/*" and not "results/".
results/*
!results/graphex.json
!results/graphene.json
!results/strawberry.json
!results/ariadne.json
!results/2x_graphex.json
!results/2x_graphene.json
!results/2x_strawberry.json
!results/2x_ariadne.json

# Ad-hoc profiler scripts and dumps (written against a point-in-time code
# state; not part of the documented benchmark contract)
profiles/

# Django migrations are generated at run time (fresh, deterministic)
benchapp/migrations/

# Python bytecode
__pycache__/
*.py[cod]
